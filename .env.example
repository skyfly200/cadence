# Google Calendar OAuth (optional). Set these to enable calendar sync.
# GOOGLE_CLIENT_ID=your-client-id
# GOOGLE_CLIENT_SECRET=your-secret
# NUXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id

# Google tokens are stored on the server, encrypted, never in the browser.
# Calendar sync also needs both of these (server-only, never NUXT_PUBLIC_):
#
# 32-byte encryption key, base64. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it stable: changing it makes stored tokens unreadable (users reconnect).
# CADENCE_TOKEN_KEY=paste-the-generated-base64-key-here
#
# Supabase service role key (Project settings > API). Bypasses row-level
# security, so treat it like a password and never expose it to the client.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# Also required once, in the Supabase SQL editor after review:
# supabase/drafts/0002_google_tokens.sql (creates the token table).

# Web push delivery of nudges (server-only, never NUXT_PUBLIC_):
# Generate with: npx web-push generate-vapid-keys
# VAPID_PRIVATE_KEY=<private-key>
# NUXT_PUBLIC_VAPID_PUBLIC_KEY=<public-key>
# VAPID_SUBJECT=mailto:example@example.com
#
# Cron secret for the dispatch endpoint (shared with Supabase Vault):
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NUDGE_CRON_SECRET=paste-the-generated-hex-secret-here
#
# Also required once, in the Supabase SQL editor after review:
# supabase/drafts/0003_nudges.sql (creates push_subscriptions and nudge_queue).

# AI layer (server-only, never NUXT_PUBLIC_). Anthropic is the default:
# ANTHROPIC_API_KEY=your-key
# Or any OpenAI-compatible endpoint (also reaches local models); needs both models:
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=optional
# Model overrides (defaults: claude-haiku-4-5 for wording, claude-sonnet-5-5 for extraction):
# AI_MODEL_FAST=
# AI_MODEL_STRONG=
# Optional: use a different model for heap tagging and triage (any OpenAI-compatible endpoint, so a
# self-hosted or local model works). The server must be able to reach it; a model on your own computer is
# only reachable if Cadence also runs there or the model is exposed to the server. Unset uses the above.
# HEAP_AI_BASE_URL=http://localhost:11434/v1
# HEAP_AI_MODEL=
# HEAP_AI_API_KEY=optional
# Calls per user per rolling 24 hours (default 100):
# AI_DAILY_CALL_CAP=100
#
# Also required once, in the Supabase SQL editor after review:
# supabase/drafts/0004_ai_layer.sql (creates ai_settings and ai_usage).

# Google Docs import (read-only). It reuses the Google sign-in above, which also asks for
# drive.file: reconnect Google once in Settings > Import after enabling these.
# Reading a Google Doc uses the Google Picker, which needs a browser API key (Google Cloud Console >
# APIs & Services > Credentials > Create credentials > API key; restrict it to the Picker API and your
# site's address). It is public by design, like the client id:
# NUXT_PUBLIC_GOOGLE_PICKER_API_KEY=your-picker-api-key
