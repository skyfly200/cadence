// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =====================================================
// Intentional Daily Orchestrator
// =====================================================

model Task {
  id                  String           @id @default(cuid())
  title               String
  notes               String?
  status              String           @default("backlog") // backlog | incubator | today | completed | triage_review
  eisenhowerCategory  String           @default("schedule") // do_first | schedule | delegate | eliminate
  estimatedMinutes    Int              @default(30)
  actualMinutes       Int              @default(0)
  category            String           @default("Admin") // Creative | Admin | Maintenance | Health | Learning | Social
  rolledOverCount     Int              @default(0)
  priority            Int              @default(2) // 1=high 5=low
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  completedAt         DateTime?

  timeBlocks          TimeBlock[]
  timerSessions       TimeLogSession[]
}

model TimeBlock {
  id              String   @id @default(cuid())
  taskId          String?
  title           String
  startTime       DateTime
  endTime         DateTime
  isAnchor        Boolean  @default(false) // meals, water, sleep
  isExternalEvent Boolean  @default(false) // Google Calendar sync
  anchorType      String?  // breakfast | lunch | dinner | water | sleep | workout
  colorTag        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  task            Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TimeLogSession {
  id              String    @id @default(cuid())
  taskId          String
  type            String    @default("pomodoro") // pomodoro | open_flow
  startTime       DateTime
  endTime         DateTime?
  elapsedSeconds  Int       @default(0)
  interrupted     Boolean   @default(false)
  createdAt       DateTime  @default(now())

  task            Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model DailyCapacity {
  id                    String   @id @default(cuid())
  date                  String   @unique // YYYY-MM-DD
  readinessScore        Int?     // 0-100 from wearable
  sleepHours            Float?
  manualEnergyRating    Int?     // 1-10
  maxAllowedFocusMinutes Int     @default(270)
  scheduledFocusMinutes Int      @default(0)
  triageCompleted       Boolean  @default(false)
  triageStreak          Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model GamificationLog {
  id           String   @id @default(cuid())
  date         String   // YYYY-MM-DD
  type         String   // realism | anchor_discipline | triage_streak | completion | focus_session
  points       Int
  note         String?
  createdAt    DateTime @default(now())
}

model Settings {
  id                  String   @id @default("singleton")
  wakeTime            String   @default("07:00")
  sleepTime           String   @default("23:00")
  breakfastTime       String   @default("08:00")
  lunchTime           String   @default("13:00")
  dinnerTime          String   @default("19:00")
  hydrationInterval   Int      @default(90) // minutes between water reminders
  defaultPomodoroMinutes Int   @default(25)
  defaultBreakMinutes Int      @default(5)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
